# Backend environment variables.
#
# Spring Boot does not read this file on its own: export them in your shell, or load the file
# with  set -a && source .env && set +a
#
# .env is git-ignored. Never commit your key.

# Required. Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Defaults in parentheses.
# REVIEWER_MODEL=claude-opus-5-5          (the model that reviews)
# REVIEWER_MAX_TOKENS=16000               (cap on the model's answer)
# SERVER_PORT=8080                        (backend port)
# ANTHROPIC_BASE_URL=https://...          (route through a gateway of your own)
